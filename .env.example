# Copy to .env and fill in. Never commit .env.

# HTTP
PORT=3000

# SQLite database file
DB_PATH=./data/waste.db

# Admin API token - protects every /api/v1/admin route and the dashboard.
# Generate one: node -e "console.log(crypto.randomUUID())"
ADMIN_TOKEN=change-me

# --- Alerting -------------------------------------------------------------
# Telegram is the cheapest transport: free, unlimited, instant push to phone.
# 1. Message @BotFather on Telegram -> /newbot -> copy the token
# 2. Message your new bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id
# Leave blank to log alerts to the console instead (useful in development).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Monitoring sweep -----------------------------------------------------
# How often to check for bins that have gone silent (seconds)
SWEEP_INTERVAL_SECONDS=300
